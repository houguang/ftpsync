{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FTPSync",
  "version": "0.1.0",
  "identifier": "com.houguang.ftpsync",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FTPSync · 实时文件同步",
        "width": 1200,
        "height": 820,
        "minWidth": 980,
        "minHeight": 660,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
